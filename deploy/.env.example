# Copia este archivo como deploy/.env y rellena los valores. NUNCA subas .env al repositorio.

# IP pública o dominio del servidor (VPS) donde corre coturn.
PUBLIC_HOST=example.com

# Secreto compartido entre el backend y coturn para las credenciales TURN temporales.
# Genera uno con:  openssl rand -base64 32
GAMESHARE_TURN_SECRET=

# Opcional: clave para limitar quién puede crear salas (cabecera X-Host-Key).
# Genera una con:  openssl rand -base64 24
GAMESHARE_HOST_KEY=

# Orígenes permitidos (la app Electron usa app://gameshare).
GAMESHARE_ALLOWED_ORIGINS=app://gameshare,http://localhost:4200
